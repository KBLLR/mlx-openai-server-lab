# MLX OpenAI server environment variables.
# Copy this file to .env and fill in values locally. Leave unused names blank.
# Do not commit .env or put secrets in this file.

# Path or Hugging Face repo id of the model to load.
MODEL_PATH=

# Model type: lm, multimodal, image-generation, image-edit, embeddings, or whisper.
MODEL_TYPE=

# Context length for lm and multimodal models.
CONTEXT_LENGTH=

# Address and port the API server binds to.
SERVER_HOST=
SERVER_PORT=

# Request queue limits.
MAX_CONCURRENCY=
QUEUE_TIMEOUT=
QUEUE_SIZE=

# Flux image-generation and image-edit settings.
QUANTIZE=
CONFIG_NAME=
LORA_PATHS=
LORA_SCALES=

# Set to true to disable automatic resize for vision-language models.
DISABLE_AUTO_RESIZE=

# Logging. NO_LOG_FILE disables the log file when true.
LOG_FILE=
NO_LOG_FILE=
LOG_LEVEL=

# Tool-call and reasoning parsers for language models.
ENABLE_AUTO_TOOL_CHOICE=
TOOL_CALL_PARSER=
REASONING_PARSER=

# Set to true to allow custom code from model repositories.
TRUST_REMOTE_CODE=

# Set to true to warm the KV cache at startup.
MLX_WARMUP=

# CORS. ALLOWED_ORIGINS is a comma-separated list of origins.
ALLOWED_ORIGINS=
CAMPUS_FRONTEND_URL=

# Sampling defaults used by language and vision model wrappers.
DEFAULT_TEMPERATURE=
DEFAULT_TOP_P=
DEFAULT_TOP_K=
DEFAULT_MIN_P=
DEFAULT_SEED=
DEFAULT_MAX_TOKENS=
DEFAULT_BATCH_SIZE=

# Optional client scripts (scripts/llm_health_dashboard.py, scripts/test_llm_contracts.py).
MLX_URL=
MLX_API_KEY=
OPENAI_API_KEY=
MLX_ACTIVE_MODEL=
MLX_MODEL_ID=
MLX_DASHBOARD_REFRESH=
